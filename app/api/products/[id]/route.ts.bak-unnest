import { NextResponse } from "next/server";
import { neon } from "@neondatabase/serverless";
import { auth } from "@/lib/auth/server";

export const runtime = "nodejs";

const sql = neon(process.env.DATABASE_URL!);

type RouteContext = {
  params: Promise<{ id: string }>;
};

async function requireStaff() {
  const { data: session } = await auth.getSession();
  const user = session?.user;

  if (!user?.id) {
    return {
      error: NextResponse.json(
        { error: "Please sign in first." },
        { status: 401 }
      ),
    };
  }

  const rows = await sql.query(
    `SELECT role, approval_status
     FROM public.app_users
     WHERE id = $1
     LIMIT 1`,
    [user.id]
  );

  const profile = rows[0] as
    | { role: string; approval_status: string }
    | undefined;

  if (
    !["ADMIN", "EMPLOYEE"].includes(profile?.role ?? "") ||
    profile?.approval_status !== "APPROVED"
  ) {
    return {
      error: NextResponse.json(
        { error: "Only approved staff can manage products." },
        { status: 403 }
      ),
    };
  }

  return { user };
}

export async function PATCH(request: Request, context: RouteContext) {
  try {
    const staff = await requireStaff();
    if ("error" in staff) return staff.error;

    const { id } = await context.params;
    const body = await request.json();

    const name = typeof body.name === "string" ? body.name.trim() : "";
    const category = body.category;
    const price = Number(body.price);
    const description =
      typeof body.description === "string" ? body.description.trim() : "";
    const imageUrl = body.imageUrl;

    if (!id || !name) {
      return NextResponse.json(
        { error: "Product ID and name are required." },
        { status: 400 }
      );
    }

    if (
      !["READY_MADE", "FARM"].includes(category) ||
      !Number.isSafeInteger(price) ||
      price <= 0
    ) {
      return NextResponse.json(
        { error: "Choose a valid category and a whole-number price." },
        { status: 400 }
      );
    }

    if (description.length > 2000) {
      return NextResponse.json(
        { error: "Product description must be 2000 characters or fewer." },
        { status: 400 }
      );
    }

    if (
      imageUrl !== undefined &&
      (typeof imageUrl !== "string" ||
        !imageUrl.startsWith("https://"))
    ) {
      return NextResponse.json(
        { error: "The image URL is invalid." },
        { status: 400 }
      );
    }

    // Validate optional variants array (same rules as POST)
    const variantsInput = Array.isArray(body.variants) ? body.variants : null;

    let variants: Array<{ label: string; price: number; available: boolean }> =
      [];

    if (variantsInput !== null) {
      if (variantsInput.length > 20) {
        return NextResponse.json(
          { error: "A product can have at most 20 variants." },
          { status: 400 }
        );
      }

      for (const raw of variantsInput) {
        if (!raw || typeof raw !== "object") {
          return NextResponse.json(
            { error: "Each variant must be an object." },
            { status: 400 }
          );
        }

        const vLabel =
          typeof (raw as Record<string, unknown>).label === "string"
            ? ((raw as Record<string, unknown>).label as string).trim()
            : "";
        const vPrice = Number((raw as Record<string, unknown>).price);
        const vAvailable =
          (raw as Record<string, unknown>).available !== false;

        if (
          !vLabel ||
          vLabel.length > 40 ||
          !Number.isSafeInteger(vPrice) ||
          vPrice <= 0
        ) {
          return NextResponse.json(
            {
              error:
                "Each variant needs a label (max 40 chars) and a whole-number price above 0.",
            },
            { status: 400 }
          );
        }

        variants.push({ label: vLabel, price: vPrice, available: vAvailable });
      }

      const labels = variants.map((v) => v.label);
      if (new Set(labels).size !== labels.length) {
        return NextResponse.json(
          { error: "Variant labels must be unique per product." },
          { status: 400 }
        );
      }
    }

    const categories = await sql.query(
      `SELECT id
       FROM public.categories
       WHERE type = $1 AND active = true
       LIMIT 1`,
      [category]
    );

    const categoryRow = categories[0] as { id: string } | undefined;

    if (!categoryRow) {
      return NextResponse.json(
        { error: "The selected category was not found or is inactive." },
        { status: 400 }
      );
    }

    const updated = await sql.query(
      `UPDATE public.products
       SET name = $1,
           category_id = $2,
           price_kes = $3,
           description = $4,
           updated_at = NOW()
       WHERE id = $5 AND available = true
       RETURNING id`,
      [name, categoryRow.id, price, description, id]
    );

    if (updated.length === 0) {
      return NextResponse.json(
        { error: "Product not found or already deleted." },
        { status: 404 }
      );
    }

    // Replace image only if a new one was uploaded
    if (typeof imageUrl === "string") {
      await sql.query(
        `DELETE FROM public.product_images WHERE product_id = $1`,
        [id]
      );

      await sql.query(
        `INSERT INTO public.product_images
           (product_id, url, alt_text, position)
         VALUES ($1, $2, $3, 0)`,
        [id, imageUrl, name]
      );
    }

    // Replace variants only if the client sent a variants array.
    // (If body.variants is undefined, keep existing variants untouched.)
    if (variantsInput !== null) {
      await sql.query(
        `DELETE FROM public.product_variants WHERE product_id = $1`,
        [id]
      );

      if (variants.length > 0) {
        const valuesSql = variants
          .map(
            (_v, i) =>
              `($1::uuid, $${i * 4 + 2}::text, $${i * 4 + 3}::integer, $${i * 4 + 4}::boolean, ${i}::integer)`
          )
          .join(", ");

        const params: unknown[] = [id];
        for (const v of variants) {
          params.push(v.label, v.price, v.available ?? true);
        }

        await sql.query(
          `INSERT INTO public.product_variants
             (product_id, label, price_kes, available, position)
           VALUES ${valuesSql}`,
          params
        );
      }
    }

    return NextResponse.json({ success: true });
  } catch (error) {
    console.error("Update product error:", error);

    return NextResponse.json(
      { error: "Could not update the product." },
      { status: 500 }
    );
  }
}

export async function DELETE(_request: Request, context: RouteContext) {
  try {
    const staff = await requireStaff();
    if ("error" in staff) return staff.error;

    const { id } = await context.params;

    const rows = await sql.query(
      `UPDATE public.products
       SET available = false,
           updated_at = NOW()
       WHERE id = $1 AND available = true
       RETURNING id`,
      [id]
    );

    if (rows.length === 0) {
      return NextResponse.json(
        { error: "Product not found or already deleted." },
        { status: 404 }
      );
    }

    return NextResponse.json({ success: true });
  } catch (error) {
    console.error("Delete product error:", error);

    return NextResponse.json(
      { error: "Could not delete the product." },
      { status: 500 }
    );
  }
}